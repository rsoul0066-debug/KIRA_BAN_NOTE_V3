   2. PARTICULES
   ================================================== */
(function makeParticles() {
  const zone = document.getElementById('particles');
  const frag = document.createDocumentFragment();
  for (let i = 0; i < 26; i++) {
    const p = document.createElement('i');
    const size = Math.random() * 4 + 2;
    p.style.left  = Math.random() * 100 + '%';
    p.style.width = size + 'px';
    p.style.height = size + 'px';
    p.style.animationDuration = (Math.random() * 12 + 10) + 's';
    p.style.animationDelay    = (Math.random() * 12) + 's';
    frag.appendChild(p);
  }
  zone.appendChild(frag);
})();

/* ==================================================
   3. DRAWER (DEMI-PAGE) — MENU 3 TRAITS
   ================================================== */
const menuBtn       = document.getElementById('menuBtn');
const drawer        = document.getElementById('drawer');
const drawerOverlay = document.getElementById('drawerOverlay');

function openDrawer() {
  drawer.classList.add('show');
  drawerOverlay.classList.add('show');
  menuBtn.classList.add('open');
  drawer.setAttribute('aria-hidden', 'false');
}
function closeDrawer() {
  drawer.classList.remove('show');
  drawerOverlay.classList.remove('show');
  menuBtn.classList.remove('open');
  drawer.setAttribute('aria-hidden', 'true');
}

menuBtn.addEventListener('click', () => {
  drawer.classList.contains('show') ? closeDrawer() : openDrawer();
});
drawerOverlay.addEventListener('click', closeDrawer);

document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && drawer.classList.contains('show')) closeDrawer();
});

/* ==================================================
   4. SÉLECTION DU PAYS
   ================================================== */
const countryBtn = document.getElementById('countryBtn');
const curFlag    = document.getElementById('curFlag');
const curDial    = document.getElementById('curDial');
const modal      = document.getElementById('modal');
const search     = document.getElementById('search');
const list       = document.getElementById('countryList');
const field      = document.getElementById('field');
const phone      = document.getElementById('phone');
const hint       = document.getElementById('hint');
const banBtn     = document.getElementById('banBtn');
const toast      = document.getElementById('toast');

let selected = COUNTRIES.find(c => c.i === 'cg');

function renderList(filter = '') {
  const f = filter.trim().toLowerCase();
  const results = COUNTRIES.filter(c =>
    !f || c.n.toLowerCase().includes(f) || c.d.includes(f) || c.i.includes(f)
  );

  list.innerHTML = '';

  if (!results.length) {
    const li = document.createElement('li');
    li.className = 'no-result';
    li.textContent = 'Aucun pays trouvé';
    li.style.display = 'block';
    list.appendChild(li);
    return;
  }

  const frag = document.createDocumentFragment();
  results.forEach(c => {
    const li = document.createElement('li');
    if (selected && c.i === selected.i) li.classList.add('active');

    const img = document.createElement('img');
    img.src = `https://flagcdn.com/w40/${c.i}.png`;
    img.alt = ''; img.loading = 'lazy';
    img.onerror = () => { img.style.visibility = 'hidden'; };

    const name = document.createElement('span');
    name.className = 'cname';
    name.textContent = c.n;

    const dial = document.createElement('span');
    dial.className = 'cdial';
    dial.textContent = c.d;

    li.append(img, name, dial);
    li.addEventListener('click', () => chooseCountry(c));
    frag.appendChild(li);
  });
  list.appendChild(frag);
}

function chooseCountry(c) {
  selected = c;
  curFlag.src = `https://flagcdn.com/w40/${c.i}.png`;
  curFlag.style.visibility = 'visible';
  curFlag.onerror = () => { curFlag.style.visibility = 'hidden'; };
  curDial.textContent = c.d;
  closeModal();
  hint.classList.remove('err');
  hint.textContent = c.n + ' — ' + c.d;
  phone.focus();
}

function openModal() {
  modal.classList.add('show');
  countryBtn.classList.add('open');
  search.value = '';
  renderList();
  setTimeout(() => search.focus(), 250);
}
function closeModal() {
  modal.classList.remove('show');
  countryBtn.classList.remove('open');
}

countryBtn.addEventListener('click', () => {
  modal.classList.contains('show') ? closeModal() : openModal();
});
modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && modal.classList.contains('show')) closeModal();
});
search.addEventListener('input', () => renderList(search.value));

/* ==================================================
   5. CHAMP NUMÉRO — CHIFFRES ILLIMITÉS
   ================================================== */
phone.addEventListener('input', () => {
  const digits = phone.value.replace(/\D/g, '');
  phone.value = digits.replace(/(\d{3})(?=\d)/g, '$1 ');
  field.classList.remove('error');
  hint.classList.remove('err');
  if (!hint.textContent.includes('—')) {
    hint.textContent = selected.n + ' — ' + selected.d;
  }
});

phone.addEventListener('keydown', e => {
  if (e.key === 'Enter') banBtn.click();
});

