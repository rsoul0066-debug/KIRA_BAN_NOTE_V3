<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ban Note — Mr Kira Tech</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
/* ================= BASE ================= */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}

:root{
  --red:#ff2b4a;
  --red-light:#ff8fa3;
  --red-bright:#ff5470;
  --red-deep:#8b0a1e;
  --dark:#0a0506;
  --panel:#12060a;
}

html,body{height:100%}

body{
  font-family:'Inter',system-ui,-apple-system,sans-serif;
  background:var(--dark);
  color:#fdeef1;
  overflow:hidden;
  -webkit-tap-highlight-color:transparent;
}

/* ================= SPLASH ================= */
#splash{
  position:fixed;inset:0;z-index:100;
  display:flex;align-items:center;justify-content:center;
  background:
    radial-gradient(circle at 50% 42%, rgba(255,43,74,.22), transparent 62%),
    linear-gradient(rgba(8,2,3,.78), rgba(8,2,3,.95)),
    url('https://i.ibb.co/MyB70Mjh/7157-A577-8806-4727-AF86-AA48-ECFC12-F4.jpg') center/cover no-repeat;
  transition:opacity .9s ease, transform .9s ease, filter .9s ease;
}
#splash.hide{opacity:0;transform:scale(1.08);filter:blur(14px);pointer-events:none}

.splash-inner{text-align:center;padding:24px;animation:fadeUp .9s cubic-bezier(.2,.8,.25,1) both}

.logo-ring{
  width:118px;height:118px;margin:0 auto 30px;border-radius:50%;
  display:grid;place-items:center;position:relative;
  background:radial-gradient(circle, rgba(255,43,74,.20), transparent 72%);
}
.logo-ring::before,
.logo-ring::after{
  content:'';position:absolute;inset:0;border-radius:50%;
  border:2px solid rgba(255,43,74,.5);
  animation:pulseRing 2.6s ease-out infinite;
}
.logo-ring::after{animation-delay:1.3s}
@keyframes pulseRing{0%{transform:scale(.85);opacity:.9}100%{transform:scale(1.55);opacity:0}}

.logo-ring span{
  font-family:'Orbitron',sans-serif;font-size:2rem;font-weight:800;letter-spacing:2px;
  background:linear-gradient(135deg,#ff2b4a,#ff8fa3,#ff5470);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 0 18px rgba(255,43,74,.75));
}

.splash-inner h1{
  font-family:'Orbitron',sans-serif;font-weight:600;
  font-size:clamp(1.05rem,4.6vw,1.85rem);
  letter-spacing:1.2px;color:#ffe6ea;
  text-shadow:0 0 26px rgba(255,43,74,.55);line-height:1.5;
}
.splash-inner h1 .grad{
  background:linear-gradient(120deg,#ff2b4a,#ff8fa3,#ff2b4a);
  background-size:200% 100%;
  -webkit-background-clip:text;background-clip:text;color:transparent;
  animation:flow 3s linear infinite;
}
@keyframes flow{0%{background-position:0% 50%}100%{background-position:200% 50%}}

.progress{
  width:min(340px,78vw);height:8px;margin:30px auto 14px;
  border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden;
  box-shadow:inset 0 0 14px rgba(0,0,0,.7), 0 0 0 1px rgba(255,43,74,.18);
}
#bar{
  height:100%;width:0%;border-radius:99px;
  background:linear-gradient(90deg,#8b0a1e,#ff2b4a,#ff8fa3,#ff2b4a);
  background-size:200% 100%;
  animation:flow 1.6s linear infinite;
  box-shadow:0 0 18px rgba(255,43,74,.9);
  transition:width .18s linear;
}
#loadTxt{
  font-size:.8rem;letter-spacing:2px;text-transform:uppercase;
  color:rgba(255,143,163,.8);font-weight:600;
}

/* ================= APP ================= */
#app{
  position:fixed;inset:0;display:flex;align-items:center;justify-content:center;
  padding:22px;overflow-y:auto;
  opacity:0;visibility:hidden;
  transition:opacity 1s ease, visibility 1s;
  background:
    radial-gradient(circle at 18% 12%, rgba(255,43,74,.16), transparent 55%),
    radial-gradient(circle at 88% 88%, rgba(139,10,30,.28), transparent 58%),
    linear-gradient(rgba(8,2,3,.82), rgba(8,2,3,.96));
}
#app::before{
  content:'';position:fixed;inset:0;z-index:-1;
  background:url('https://i.ibb.co/b4cs1zX/5-E169-D24-F0-EA-499-B-B431-8-CA38-C0-BA2-A5.jpg') center/cover no-repeat;
  filter:brightness(.4) saturate(1.1) hue-rotate(-15deg);
}
#app.show{opacity:1;visibility:visible}

.particles{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:0}
.particles i{
  position:absolute;bottom:-40px;width:5px;height:5px;border-radius:50%;
  background:radial-gradient(circle,#ff8fa3,rgba(255,43,74,0));
  animation:rise linear infinite;opacity:.55;
}
@keyframes rise{
  0%{transform:translateY(0) scale(.6);opacity:0}
  12%{opacity:.7}
  100%{transform:translateY(-115vh) scale(1.15);opacity:0}
}

/* ================= BOUTON MENU (3 TRAITS) ================= */
#menuBtn{
  position:fixed;
  top:20px;right:20px;
  z-index:90;
  width:56px;height:56px;
  border-radius:16px;
  border:1px solid rgba(255,43,74,.4);
  background:linear-gradient(160deg, rgba(30,8,12,.85), rgba(12,3,5,.9));
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  cursor:pointer;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  gap:6px;
  box-shadow:0 10px 30px rgba(0,0,0,.6), 0 0 30px rgba(255,43,74,.18);
  transition:transform .25s ease, box-shadow .3s ease, border-color .3s ease;
  opacity:0;visibility:hidden;
}
#app.show ~ #menuBtn,
body.ready #menuBtn{opacity:1;visibility:visible}

#menuBtn:hover{
  transform:translateY(-3px) scale(1.05);
  border-color:rgba(255,43,74,.8);
  box-shadow:0 16px 40px rgba(0,0,0,.7), 0 0 45px rgba(255,43,74,.45);
}
#menuBtn:active{transform:scale(.96)}

#menuBtn span{
  display:block;
  width:24px;height:2.5px;
  border-radius:99px;
  background:linear-gradient(90deg,#ff2b4a,#ff8fa3);
  box-shadow:0 0 10px rgba(255,43,74,.7);
  transition:transform .35s cubic-bezier(.2,.8,.25,1), opacity .25s, width .3s;
}
#menuBtn span:nth-child(2){width:18px}
#menuBtn:hover span:nth-child(2){width:24px}

#menuBtn.open span:nth-child(1){transform:translateY(8.5px) rotate(45deg)}
#menuBtn.open span:nth-child(2){opacity:0;transform:scaleX(0)}
#menuBtn.open span:nth-child(3){transform:translateY(-8.5px) rotate(-45deg)}

/* Halo pulsant derrière le bouton */
#menuBtn::after{
  content:'';position:absolute;inset:-6px;border-radius:20px;
  border:1px solid rgba(255,43,74,.35);
  animation:haloPulse 2.8s ease-out infinite;
  pointer-events:none;
}
@keyframes haloPulse{
  0%{transform:scale(.92);opacity:.8}
  100%{transform:scale(1.28);opacity:0}
}

/* ================= DRAWER (DEMI-PAGE) ================= */
#drawerOverlay{
  position:fixed;inset:0;z-index:95;
  background:rgba(4,0,1,.7);
  backdrop-filter:blur(6px);
  -webkit-backdrop-filter:blur(6px);
  opacity:0;visibility:hidden;
  transition:opacity .45s ease, visibility .45s;
}
#drawerOverlay.show{opacity:1;visibility:visible}

#drawer{
  position:fixed;
  top:0;right:0;
  z-index:96;
  height:100%;
  width:min(460px, 90vw);
  background:linear-gradient(200deg, rgba(28,7,11,.98), rgba(10,3,5,.99));
  border-left:1px solid rgba(255,43,74,.32);
  box-shadow:-30px 0 80px rgba(0,0,0,.8), -4px 0 60px rgba(255,43,74,.12);
  transform:translateX(105%);
  transition:transform .55s cubic-bezier(.22,.9,.25,1);
  display:flex;flex-direction:column;
  overflow:hidden;
}
#drawer.show{transform:translateX(0)}

/* Lueur décorative dans le drawer */
#drawer::before{
  content:'';position:absolute;top:-120px;right:-120px;
  width:340px;height:340px;border-radius:50%;
  background:radial-gradient(circle, rgba(255,43,74,.28), transparent 68%);
  filter:blur(30px);
  pointer-events:none;
}
#drawer::after{
  content:'';position:absolute;bottom:-140px;left:-100px;
  width:300px;height:300px;border-radius:50%;
  background:radial-gradient(circle, rgba(139,10,30,.35), transparent 70%);
  filter:blur(34px);
  pointer-events:none;
}

.drawer-scroll{
  position:relative;z-index:2;
  flex:1;overflow-y:auto;
  padding:90px 24px 30px;
  scrollbar-width:thin;
  scrollbar-color:rgba(255,43,74,.5) transparent;
}
.drawer-scroll::-webkit-scrollbar{width:6px}
.drawer-scroll::-webkit-scrollbar-thumb{background:rgba(255,43,74,.5);border-radius:99px}

.drawer-title{
  font-family:'Orbitron',sans-serif;
  font-size:.78rem;
  font-weight:700;
  letter-spacing:3px;
  color:var(--red-light);
  margin-bottom:8px;
  opacity:0;transform:translateX(24px);
  transition:opacity .5s ease, transform .5s ease;
}
#drawer.show .drawer-title{opacity:1;transform:translateX(0);transition-delay:.22s}

.drawer-h2{
  font-family:'Orbitron',sans-serif;
  font-size:clamp(1.35rem,5vw,1.7rem);
  font-weight:800;
  letter-spacing:2px;
  line-height:1.25;
  background:linear-gradient(120deg,#ffffff,#ff8fa3,#ff2b4a,#ffffff);
  background-size:220% 100%;
  -webkit-background-clip:text;background-clip:text;
  color:transparent;
  animation:flow 5s linear infinite;
  margin-bottom:10px;
  opacity:0;transform:translateX(24px);
  transition:opacity .5s ease, transform .5s ease;
}
#drawer.show .drawer-h2{opacity:1;transform:translateX(0);transition-delay:.3s}

.drawer-sub{
  font-size:.82rem;
  color:rgba(253,238,241,.55);
  line-height:1.6;
  margin-bottom:26px;
  opacity:0;transform:translateX(24px);
  transition:opacity .5s ease, transform .5s ease;
}
#drawer.show .drawer-sub{opacity:1;transform:translateX(0);transition-delay:.38s}

/* --- Cartes de liens --- */
.link-card{
  position:relative;
  display:flex;align-items:center;gap:14px;
  padding:16px 16px;
  margin-bottom:12px;
  border-radius:16px;
  text-decoration:none;
  color:inherit;
  background:linear-gradient(150deg, rgba(255,255,255,.07), rgba(255,255,255,.02));
  border:1px solid rgba(255,255,255,.09);
  overflow:hidden;
  opacity:0;transform:translateX(40px);
  transition:
    opacity .5s ease,
    transform .5s ease,
    border-color .3s ease,
    box-shadow .3s ease,
    background .3s ease;
}
#drawer.show .link-card{opacity:1;transform:translateX(0)}
#drawer.show .link-card:nth-child(1){transition-delay:.44s}
#drawer.show .link-card:nth-child(2){transition-delay:.50s}
#drawer.show .link-card:nth-child(3){transition-delay:.56s}
#drawer.show .link-card:nth-child(4){transition-delay:.62s}
#drawer.show .link-card:nth-child(5){transition-delay:.68s}

.link-card:hover{
  transform:translateX(-4px);
  border-color:rgba(255,43,74,.55);
  background:linear-gradient(150deg, rgba(255,43,74,.14), rgba(255,43,74,.04));
  box-shadow:0 12px 32px rgba(0,0,0,.5), 0 0 30px rgba(255,43,74,.22);
}
.link-card:active{transform:translateX(-4px) scale(.98)}

/* Reflet au survol */
.link-card::before{
  content:'';position:absolute;top:0;left:-80%;
  width:50%;height:100%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.14),transparent);
  transform:skewX(-22deg);
  transition:left .6s ease;
  pointer-events:none;
}
.link-card:hover::before{left:130%}

.link-icon{
  width:46px;height:46px;flex-shrink:0;
  border-radius:13px;
  display:grid;place-items:center;
  background:linear-gradient(150deg, rgba(255,43,74,.22), rgba(255,43,74,.06));
  border:1px solid rgba(255,43,74,.28);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.08);
  transition:transform .35s cubic-bezier(.2,.8,.25,1);
}
.link-card:hover .link-icon{transform:scale(1.08) rotate(-4deg)}
.link-icon svg{width:22px;height:22px;fill:#ff8fa3;filter:drop-shadow(0 0 8px rgba(255,43,74,.6))}

.link-body{flex:1;min-width:0}
.link-body .lbl{
  font-size:.66rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;
  color:rgba(255,143,163,.75);margin-bottom:3px;
}
.link-body .ttl{
  font-size:.98rem;font-weight:700;color:#fff;letter-spacing:.3px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.link-body .sub{
  font-size:.72rem;color:rgba(253,238,241,.4);margin-top:2px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}

.link-arrow{
  width:26px;height:26px;flex-shrink:0;
  display:grid;place-items:center;
  color:rgba(255,143,163,.6);
  transition:transform .3s ease, color .3s ease;
}
.link-card:hover .link-arrow{transform:translateX(4px);color:var(--red)}
.link-arrow svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}

/* --- Séparateur --- */
.drawer-sep{
  display:flex;align-items:center;gap:12px;
  margin:24px 0 18px;
  opacity:0;transition:opacity .5s ease;
}
#drawer.show .drawer-sep{opacity:1;transition-delay:.72s}
.drawer-sep::before,
.drawer-sep::after{
  content:'';flex:1;height:1px;
  background:linear-gradient(90deg,transparent,rgba(255,43,74,.4),transparent);
}
.drawer-sep span{
  font-size:.62rem;font-weight:700;letter-spacing:2.4px;
  color:rgba(255,143,163,.6);text-transform:uppercase;
}

/* --- Carte Dark Purge (mise en avant) --- */
.dark-card{
  position:relative;
  display:block;
  padding:20px 18px;
  border-radius:18px;
  text-decoration:none;
  color:inherit;
  background:linear-gradient(150deg, rgba(255,43,74,.2), rgba(139,10,30,.12));
  border:1px solid rgba(255,43,74,.5);
  overflow:hidden;
  opacity:0;transform:translateY(20px);
  transition:opacity .55s ease, transform .55s ease, box-shadow .35s ease, border-color .35s;
  box-shadow:0 0 40px rgba(255,43,74,.18);
}
#drawer.show .dark-card{opacity:1;transform:translateY(0);transition-delay:.82s}
.dark-card:hover{
  transform:translateY(-4px);
  border-color:var(--red);
  box-shadow:0 16px 44px rgba(0,0,0,.6), 0 0 60px rgba(255,43,74,.45);
}
.dark-card::before{
  content:'';position:absolute;top:-60%;left:-70%;
  width:55%;height:220%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.16),transparent);
  transform:rotate(22deg);
  animation:sweep 5s ease-in-out infinite;
  pointer-events:none;
}
@keyframes sweep{0%,58%{left:-75%}100%{left:135%}}

.dark-top{display:flex;align-items:center;gap:13px;margin-bottom:10px}
.dark-ico{
  width:48px;height:48px;border-radius:14px;flex-shrink:0;
  display:grid;place-items:center;
  background:linear-gradient(150deg,#ff2b4a,#8b0a1e);
  box-shadow:0 0 26px rgba(255,43,74,.55), inset 0 1px 0 rgba(255,255,255,.35);
  animation:icoFloat 3.4s ease-in-out infinite;
}
@keyframes icoFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
.dark-ico svg{width:24px;height:24px;fill:#fff;filter:drop-shadow(0 0 6px rgba(255,255,255,.4))}

.dark-ttl{
  font-family:'Orbitron',sans-serif;
  font-size:1.05rem;font-weight:800;letter-spacing:1.6px;
  color:#fff;
  text-shadow:0 0 18px rgba(255,43,74,.7);
}
.dark-tag{
  font-size:.65rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;
  color:var(--red-light);margin-top:2px;
}
.dark-url{
  font-size:.74rem;color:rgba(253,238,241,.55);
  letter-spacing:.3px;word-break:break-all;
  margin-bottom:14px;
}
.dark-cta{
  display:inline-flex;align-items:center;gap:8px;
  padding:11px 20px;border-radius:12px;
  background:linear-gradient(120deg,#8b0a1e,#ff2b4a,#ff8fa3,#ff2b4a,#8b0a1e);
  background-size:220% 100%;
  font-family:'Orbitron',sans-serif;
  font-size:.76rem;font-weight:800;letter-spacing:2px;
  color:#1a0206;
  box-shadow:0 10px 26px rgba(255,43,74,.45), inset 0 1px 0 rgba(255,255,255,.5);
  transition:background-position .7s ease, transform .25s ease, box-shadow .3s;
}
.dark-card:hover .dark-cta{
  background-position:100% 50%;
  transform:translateX(3px);
  box-shadow:0 14px 34px rgba(255,43,74,.6), inset 0 1px 0 rgba(255,255,255,.6);
}
.dark-cta svg{width:15px;height:15px;fill:none;stroke:#1a0206;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}

/* ================= CARTE PRINCIPALE ================= */
.card{
  position:relative;z-index:2;width:min(470px,100%);
  padding:34px 26px 26px;border-radius:26px;
  background:linear-gradient(160deg, rgba(255,255,255,.09), rgba(255,255,255,.028));
  border:1px solid rgba(255,43,74,.32);
  backdrop-filter:blur(18px) saturate(140%);
  -webkit-backdrop-filter:blur(18px) saturate(140%);
  box-shadow:
    0 30px 70px rgba(0,0,0,.7),
    0 0 60px rgba(255,43,74,.12),
    inset 0 1px 0 rgba(255,255,255,.10);
  animation:cardIn .9s cubic-bezier(.2,.8,.25,1) both;
  overflow:hidden;
}
@keyframes cardIn{from{opacity:0;transform:translateY(40px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}

.card::before{
  content:'';position:absolute;top:-60%;left:-70%;width:55%;height:220%;
  background:linear-gradient(90deg,transparent,rgba(255,143,163,.14),transparent);
  transform:rotate(22deg);animation:sweep 6s ease-in-out infinite;pointer-events:none;
}

.card-head{text-align:center;margin-bottom:24px}
.badge{
  display:inline-block;padding:6px 16px;border-radius:99px;
  font-size:.68rem;font-weight:700;letter-spacing:2.6px;text-transform:uppercase;
  color:var(--red-light);background:rgba(255,43,74,.10);
  border:1px solid rgba(255,43,74,.35);
  box-shadow:0 0 22px rgba(255,43,74,.22);margin-bottom:16px;
}
.card-head h2{
  font-family:'Orbitron',sans-serif;font-size:clamp(1.5rem,6vw,2rem);font-weight:800;
  letter-spacing:3px;
  background:linear-gradient(120deg,#ffffff,#ff8fa3,#ff2b4a,#ffffff);
  background-size:220% 100%;
  -webkit-background-clip:text;background-clip:text;color:transparent;
  animation:flow 4.5s linear infinite;
}
.card-head p{margin-top:10px;font-size:.86rem;color:rgba(253,238,241,.62);line-height:1.6}

/* ================= CHAMP ================= */
.field{
  display:flex;align-items:center;padding:4px;
  border-radius:16px;background:rgba(0,0,0,.42);
  border:1px solid rgba(255,43,74,.28);
  transition:border-color .3s, box-shadow .3s;
}
.field:focus-within{
  border-color:var(--red);
  box-shadow:0 0 0 4px rgba(255,43,74,.14), 0 0 34px rgba(255,43,74,.28);
}
.field.error{
  border-color:#ff2b4a;
  animation:shake .45s cubic-bezier(.36,.07,.19,.97);
  box-shadow:0 0 0 4px rgba(255,43,74,.16);
}
@keyframes shake{
  10%,90%{transform:translateX(-2px)}
  20%,80%{transform:translateX(4px)}
  30%,50%,70%{transform:translateX(-7px)}
  40%,60%{transform:translateX(7px)}
}

.country-btn{
  display:flex;align-items:center;gap:8px;
  padding:14px 12px;border:0;border-radius:12px;
  background:rgba(255,43,74,.08);
  border-right:1px solid rgba(255,255,255,.10);
  cursor:pointer;color:var(--red-light);
  font-family:'Orbitron',sans-serif;font-weight:700;font-size:.9rem;letter-spacing:.6px;
  white-space:nowrap;transition:background .25s, box-shadow .25s;
  flex-shrink:0;
}
.country-btn:hover{background:rgba(255,43,74,.18);box-shadow:0 0 18px rgba(255,43,74,.3)}
.country-btn img{width:22px;height:15px;border-radius:3px;object-fit:cover;box-shadow:0 0 8px rgba(0,0,0,.6)}
.country-btn svg{width:11px;height:11px;opacity:.7;transition:transform .3s}
.country-btn.open svg{transform:rotate(180deg)}

.field input{
  flex:1;min-width:0;background:transparent;border:0;outline:0;
  padding:16px 14px;font-family:'Inter',sans-serif;
  font-size:1.05rem;font-weight:600;letter-spacing:1.6px;color:#fff;
}
.field input::placeholder{color:rgba(255,255,255,.28);font-weight:400;letter-spacing:1px}

.hint{
  margin-top:10px;font-size:.74rem;letter-spacing:.6px;
  color:rgba(253,238,241,.45);text-align:center;transition:color .3s;
}
.hint.err{color:#ff8fa3;font-weight:600}

/* ================= BOUTON BAN ================= */
.ban-btn{
  position:relative;overflow:hidden;width:100%;margin-top:20px;
  padding:18px;border:0;border-radius:16px;cursor:pointer;
  font-family:'Orbitron',sans-serif;font-size:1rem;font-weight:800;letter-spacing:4px;
  color:#1a0206;
